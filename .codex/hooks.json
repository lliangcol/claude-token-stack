{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/bash-token-guard.py; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/cbm-gate.py; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/cbm-gate.py; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/cbm-gate.py; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
