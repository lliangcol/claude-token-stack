{
  "env": {
    "TOKEN_GUARD_MODE": "warn",
    "CBM_GATE_MODE": "warn",
    "CBM_GATE_BLOCK_TOOLS": "Grep,Glob",
    "ENABLE_HEADROOM": "0"
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/*secret*)",
      "Read(**/*private_key*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(docker push*)",
      "Bash(kubectl apply*)",
      "Bash(terraform apply*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/bash-token-guard.py; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/cbm-gate.py; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/cbm-gate.py; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-python-hook.js .claude/hooks/cbm-gate.py; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
