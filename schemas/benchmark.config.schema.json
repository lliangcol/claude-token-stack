{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lliangcol/claude-token-stack/schemas/benchmark.config.schema.json",
  "title": "Claude Token Stack Benchmark Config",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 1 },
              "evidence_type": {
                "type": "string",
                "enum": ["synthetic", "real", "mixed"]
              },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
